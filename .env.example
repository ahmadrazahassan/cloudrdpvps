# Copy to .env.local (never commit real values).
# Anything starting with NEXT_PUBLIC_ is shipped to the browser — keep secrets out of those.

# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for metadata, sitemap, auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Project settings → API) ───────────────────────────────────
# Leave blank to run the marketing site on built-in seed data with accounts disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses row-level security. Server only: cron routes, email outbox, scripts/make-admin.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server login-detail encryption ──────────────────────────────────────
# AES-256-GCM keys, `kid:base64key`, comma separated. The FIRST key encrypts; all keys decrypt.
# Generate with:  npm run key:gen
# To rotate: generate a new key and put it FIRST, keep the old one after it.
# Losing every key makes stored server passwords unrecoverable — back this up.
CREDENTIAL_KEYS=

# ── Cron (only needed if pg_cron is unavailable) ────────────────────────
# Min 24 chars. Callers send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Abuse protection (recommended in production) ────────────────────────
# Shared rate limiting across instances (https://upstash.com). Falls back to in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile. Both keys must be set together; with neither, bot checks are skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Transactional email via Resend (https://resend.com) ─────────────────
# Order, payment, delivery, ticket, welcome and staff emails. Until both are set, emails stay queued.
# EMAIL_FROM must be an address on a domain you have verified in Resend (SPF + DKIM).
# Sign-up and password-reset emails are sent by Supabase through Resend SMTP: see README → "Email (Resend)".
RESEND_API_KEY=
EMAIL_FROM="Cloud RDP VPS <no-reply@example.com>"
