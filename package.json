    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dotted-map": "^3.1.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "nuqs": "^2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
