{
  "name": "cloudrdpvps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests",
    "types:gen": "tsx scripts/gen-types.ts",
    "types:check": "tsx scripts/gen-types.ts --check",
    "qa:fonts": "node scripts/qa/fonts-check.mjs",
    "qa:auth": "node scripts/qa/auth-check.mjs",
    "qa:pages": "node scripts/qa/pages-check.mjs",
    "qa:checkout": "node scripts/qa/checkout-check.mjs",
    "qa:portal": "node scripts/qa/portal-check.mjs",
    "key:gen": "tsx scripts/gen-credential-key.ts",
    "make-admin": "tsx --env-file-if-exists=.env.local scripts/make-admin.ts",
    "launch:apply": "tsx --env-file-if-exists=.env.local scripts/apply-launch-countries.ts",
    "launch:seed": "node scripts/gen-launch.mjs",
    "world:gen": "node scripts/gen-world.mjs",
    "flags:build": "node scripts/build-flags.mjs",
    "globe:build": "node scripts/build-globe.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "brand:build": "node scripts/build-brand.mjs",
    "payments:build": "node scripts/build-payment-logos.mjs",
    "faqs:sync": "tsx --env-file-if-exists=.env.local scripts/sync-faqs.ts",
    "qa:admin": "node scripts/qa/portal-check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
